{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../core/src/index.ts"],
  "tsconfig": "../core/tsconfig.json",
  "plugin": ["typedoc-plugin-markdown"],
  "out": "docs/api",
  "readme": "none",
  "entryFileName": "reference",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "sort": ["source-order"],
  "disableSources": true
}
