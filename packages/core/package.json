{
  "name": "@clidoc/core",
  "version": "1.0.0",
  "description": "OpenCLI types, offline validation, and Markdown reference generation for CLI documentation",
  "keywords": [
    "cli",
    "docs",
    "docs-generator",
    "documentation",
    "json-schema",
    "markdown",
    "opencli",
    "reference",
    "validation",
    "yaml"
  ],
  "homepage": "https://clidoc.dev/docs/api",
  "bugs": {
    "url": "https://github.com/bhouston/clidoc/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/core"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "schema/spec.schema.json",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": "./schema/spec.schema.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc && tsc -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  }
}
