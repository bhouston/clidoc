{
  "name": "@clidoc/cli",
  "version": "0.1.0",
  "description": "Generate and validate OpenCLI documentation",
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/cli"
  },
  "bin": {
    "clidoc": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@clidoc/adapter-commander": "workspace:^",
    "@clidoc/adapter-oclif": "workspace:^",
    "@clidoc/adapter-yargs": "workspace:^",
    "@clidoc/core": "workspace:^",
    "yargs": "^18.1.0",
    "yargs-file-commands": "^2.0.1"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
