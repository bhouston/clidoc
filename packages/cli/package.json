{
  "name": "@clidoc/cli",
  "version": "0.1.0",
  "description": "Generate and validate OpenCLI documentation",
  "keywords": [
    "cli",
    "docs",
    "documentation",
    "opencli",
    "yargs"
  ],
  "homepage": "https://clidoc.dev",
  "bugs": {
    "url": "https://github.com/bhouston/clidoc/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/cli"
  },
  "bin": {
    "clidoc": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@clidoc/core": "workspace:^",
    "@clidoc/yargs": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "yargs": "^18.1.0",
    "yargs-file-commands": "^2.0.1"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
