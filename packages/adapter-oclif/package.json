{
  "name": "@clidoc/adapter-oclif",
  "version": "0.1.0",
  "description": "OpenCLI adapter for oclif",
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/adapter-oclif"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc"
  },
  "dependencies": {
    "@clidoc/core": "workspace:*"
  },
  "peerDependencies": {
    "@oclif/core": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@oclif/core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
