{
  "name": "@clidoc/docusaurus",
  "version": "0.1.0",
  "description": "Publish OpenCLI Markdown in Docusaurus",
  "keywords": [
    "cli",
    "docs",
    "documentation",
    "docusaurus",
    "markdown",
    "opencli"
  ],
  "homepage": "https://clidoc.dev",
  "bugs": {
    "url": "https://github.com/bhouston/clidoc/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/docusaurus"
  },
  "files": [
    "index.cjs",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@clidoc/core": "workspace:^"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
