{
  "name": "@clidoc/commander",
  "version": "1.0.0",
  "description": "Generate OpenCLI documents from Commander command trees",
  "keywords": [
    "cli",
    "commander",
    "docs",
    "documentation",
    "opencli"
  ],
  "homepage": "https://clidoc.dev",
  "bugs": {
    "url": "https://github.com/bhouston/clidoc/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/commander"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc"
  },
  "dependencies": {
    "@clidoc/core": "workspace:*"
  },
  "peerDependencies": {
    "commander": ">=11.1.0 <16.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
