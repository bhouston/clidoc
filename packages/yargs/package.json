{
  "name": "@clidoc/yargs",
  "version": "1.0.0",
  "description": "Generate CLI reference docs from Yargs command definitions via OpenCLI",
  "keywords": [
    "cli",
    "command-line",
    "docs",
    "docs-generator",
    "documentation",
    "help",
    "markdown",
    "opencli",
    "reference",
    "yargs"
  ],
  "homepage": "https://clidoc.dev/docs/frameworks",
  "bugs": {
    "url": "https://github.com/bhouston/clidoc/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git",
    "directory": "packages/yargs"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc"
  },
  "dependencies": {
    "@clidoc/core": "workspace:*"
  },
  "devDependencies": {
    "yargs": "^18.1.0",
    "yargs-file-commands": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
