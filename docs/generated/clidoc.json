{
  "opencliVersion": "1.0.0-alpha.14",
  "info": {
    "title": "clidoc",
    "binary": "clidoc",
    "version": "0.1.0",
    "summary": "Generate, validate, and publish CLI documentation through OpenCLI."
  },
  "commands": {
    "clidoc markdown": {
      "summary": "Render an OpenCLI document as Markdown",
      "args": [
        {
          "name": "input",
          "required": true,
          "type": "string",
          "summary": "OpenCLI JSON or YAML filename"
        }
      ],
      "flags": [
        {
          "name": "output",
          "type": "string",
          "aliases": [
            "o"
          ],
          "summary": "Output file; defaults to stdout"
        }
      ]
    },
    "clidoc validate": {
      "summary": "Validate an OpenCLI JSON or YAML document",
      "args": [
        {
          "name": "input",
          "required": true,
          "type": "string",
          "summary": "OpenCLI document filename"
        }
      ]
    },
    "clidoc docgen": {
      "summary": "Write clidoc’s own OpenCLI document",
      "flags": [
        {
          "name": "format",
          "type": "string",
          "summary": "Output format",
          "choices": [
            {
              "value": "json"
            },
            {
              "value": "yaml"
            },
            {
              "value": "markdown"
            }
          ],
          "default": "json"
        },
        {
          "name": "output",
          "type": "string",
          "aliases": [
            "o"
          ],
          "summary": "Output file; defaults to stdout"
        }
      ]
    },
    "clidoc completion": {
      "summary": "Generate a standalone shell completion script",
      "args": [
        {
          "name": "shell",
          "required": true,
          "type": "string",
          "summary": "Target shell",
          "choices": [
            {
              "value": "bash"
            },
            {
              "value": "zsh"
            },
            {
              "value": "fish"
            }
          ]
        }
      ],
      "flags": [
        {
          "name": "input",
          "type": "string",
          "aliases": [
            "i"
          ],
          "summary": "OpenCLI JSON or YAML file; defaults to clidoc itself"
        },
        {
          "name": "binary",
          "type": "string",
          "summary": "Executable name override for completion registration"
        },
        {
          "name": "output",
          "type": "string",
          "aliases": [
            "o"
          ],
          "summary": "Output file; defaults to stdout"
        }
      ]
    },
    "clidoc mcp": {
      "summary": "Export MCP tools or serve a trusted CLI over MCP stdio",
      "args": [
        {
          "name": "input",
          "required": true,
          "type": "string",
          "summary": "OpenCLI JSON or YAML filename"
        }
      ],
      "flags": [
        {
          "name": "output",
          "type": "string",
          "aliases": [
            "o"
          ],
          "summary": "Tool catalog output file; defaults to stdout"
        },
        {
          "name": "serve",
          "type": "boolean",
          "summary": "Serve MCP over stdin/stdout",
          "default": false
        },
        {
          "name": "executable",
          "type": "string",
          "summary": "Trusted executable to run; required with --serve"
        },
        {
          "name": "cwd",
          "type": "string",
          "summary": "Working directory for CLI invocations"
        },
        {
          "name": "timeout-ms",
          "type": "number",
          "summary": "Invocation timeout in milliseconds (default: 30000)"
        },
        {
          "name": "max-output-bytes",
          "type": "number",
          "summary": "Combined stdout/stderr limit (default: 1048576)"
        }
      ]
    }
  },
  "global": {
    "flags": [
      {
        "name": "help",
        "type": "boolean",
        "summary": "Show help"
      },
      {
        "name": "version",
        "type": "boolean",
        "summary": "Show version number"
      }
    ]
  }
}
