{
  "name": "clidoc",
  "private": true,
  "description": "JavaScript and TypeScript tooling for the OpenCLI specification",
  "homepage": "https://clidoc.dev",
  "license": "MIT",
  "author": "Ben Houston <ben@ben3d.ca> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/clidoc.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --filter './packages/*' --filter '!@clidoc/website' build && node scripts/generate-docs.mjs && pnpm -r --filter './demos/*' build",
    "dev": "pnpm --parallel --filter @clidoc/website --filter @clidoc/demo-docusaurus --filter @clidoc/demo-vitepress dev",
    "tsc": "pnpm -r tsc",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "package:check": "pnpm build && node scripts/check-package-maps.mjs",
    "release": "semantic-release",
    "test:workflow": "node --test scripts/workflow.test.mjs",
    "docs:build": "pnpm build && pnpm --filter @clidoc/website generate:api && pnpm --filter @clidoc/website build && pnpm --filter @clidoc/demo-docusaurus build && pnpm --filter @clidoc/demo-vitepress build"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.29",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.5",
    "@visulima/yaml": "1.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.83.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "vitest-command-line": "^0.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
